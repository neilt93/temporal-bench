\newlabel{sec:cross}{{5}{6}{Cross-Model Analysis}{section.5}{}}
\@writefile{toc}{\contentsline {paragraph}{The blind spot does not diminish with scale.}{6}{section*.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces GPT-4o performance across four prompting conditions. Implicit time yields only partial improvement; explicit time produces the full effect.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:gpt4o_conditions}{{3}{7}{GPT-4o performance across four prompting conditions. Implicit time yields only partial improvement; explicit time produces the full effect}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The staleness-caution tradeoff. Time annotations eliminate false trust (left) but increase unnecessary refreshing of stable facts (right), especially for smaller models like Haiku and Mistral.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:tradeoff}{{4}{7}{The staleness-caution tradeoff. Time annotations eliminate false trust (left) but increase unnecessary refreshing of stable facts (right), especially for smaller models like Haiku and Mistral}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{The benefit of annotation scales with capability.}{7}{section*.7}\protected@file@percent }

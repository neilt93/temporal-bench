\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Finding 1: Low Temporal Sensitivity Without Annotations}{4}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Switch sensitivity across all seven models with and without explicit elapsed-time annotations. Without time, all models fall in the 0--8\% range. With explicit time, the most capable models reach 100\%.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:blind_spot}{{1}{5}{Switch sensitivity across all seven models with and without explicit elapsed-time annotations. Without time, all models fall in the 0--8\% range. With explicit time, the most capable models reach 100\%}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Finding 2: Explicit Annotations Substantially Reduce the Blind Spot}{5}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Finding 3: Implicit Timestamps Are Insufficient}{5}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces False trust rate across prompting conditions for the three most capable models. Without time annotations, models trust stale information 69--100\% of the time. Explicit annotations reduce this to 0\%.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:false_trust}{{2}{6}{False trust rate across prompting conditions for the three most capable models. Without time annotations, models trust stale information 69--100\% of the time. Explicit annotations reduce this to 0\%}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Finding 4: Prompting About Staleness Does Not Help}{6}{subsection.4.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Finding 5: Smaller Models Over-Correct}{6}{subsection.4.5}\protected@file@percent }
